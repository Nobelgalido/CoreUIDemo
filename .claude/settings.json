{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/docs-sync.sh session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/docs-sync.sh check",
            "timeout": 30,
            "statusMessage": "Checking docs are in sync with code..."
          }
        ]
      }
    ]
  }
}
