@{ ViewBag.Title = "Users"; }
<div ng-controller="UsersListController as vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Users</h1>
        <button class="btn btn-primary" ng-click="vm.newUser()">
            <i class="cil-user-plus me-1"></i> New User
        </button>
    </div>

    <div class="btn-group mb-3" role="group">
        <button class="btn btn-outline-secondary" ng-class="{active: vm.filter === 'active'}" ng-click="vm.setFilter('active')">Active</button>
        <button class="btn btn-outline-secondary" ng-class="{active: vm.filter === 'inactive'}" ng-click="vm.setFilter('inactive')">Inactive</button>
        <button class="btn btn-outline-secondary" ng-class="{active: vm.filter === 'all'}" ng-click="vm.setFilter('all')">All</button>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr><th>Username</th><th>Name</th><th>Role</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="u in vm.filteredUsers">
                            <td>{{u.Username}}</td>
                            <td>{{u.FirstName}} {{u.LastName}}</td>
                            <td><span class="badge bg-secondary">{{u.Role}}</span></td>
                            <td>{{u.IsActive ? 'Active' : 'Inactive'}}</td>
                            <td>
                                <button class="btn btn-primary btn-sm" ng-click="vm.editUser(u)" title="Edit">
                                    <i class="cil-pencil"></i>
                                </button>
                                <button class="btn btn-danger btn-sm" ng-click="vm.deleteUser(u.Id)"
                                        ng-disabled="!u.IsActive || u.Id === main.CurrentUser.UserId"
                                        ng-attr-title="{{u.Id === main.CurrentUser.UserId ? 'You cannot deactivate your own account' : 'Deactivate'}}">
                                    <i class="cil-trash"></i>
                                </button>
                            </td>
                        </tr>
                        <tr ng-if="vm.filteredUsers.length === 0">
                            <td colspan="5" class="text-center text-body-secondary">No users match this filter.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create / Edit Modal -->
    <div class="modal fade" id="UserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{vm.modalHeader}} User</h5>
                    <button class="btn-close" type="button" data-coreui-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger" ng-if="vm.errors.length">
                        <div ng-repeat="e in vm.errors">{{e}}</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" class="form-control" ng-model="vm.modal.Username" ng-disabled="vm.modalHeader === 'Edit'" />
                    </div>
                    <div class="mb-3" ng-if="vm.modalHeader === 'New'">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" ng-model="vm.modal.Password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" class="form-control" ng-model="vm.modal.FirstName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" class="form-control" ng-model="vm.modal.LastName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select" ng-model="vm.modal.Role">
                            <option value="user">user</option>
                            <option value="manager">manager</option>
                            <option value="admin">admin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" ng-click="vm.save()" ng-disabled="vm.saving">Save</button>
                    <button class="btn btn-secondary" data-coreui-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>