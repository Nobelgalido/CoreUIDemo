@model CoreUIDemo.Models.AuthenticatedUserData
@{ ViewBag.Title = "My Profile"; }

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">My Profile</div>
            <div class="card-body">
                @if (Model == null)
                {
                    <p class="text-body-secondary mb-0">Session not available — try signing in again.</p>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Username</dt>
                        <dd class="col-sm-8">@Model.Username</dd>

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-4">Role</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Role</span></dd>
                    </dl>
                }
            </div>
            <div class="card-footer text-body-secondary">
                To change your password, use <strong>Change Password</strong> in the account menu, top right.
            </div>
        </div>
    </div>
</div>